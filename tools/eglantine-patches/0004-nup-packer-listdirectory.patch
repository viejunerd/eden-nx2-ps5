+// The entries of a directory. The PS5 build replaces the loop between the markers
+// (headless/CMakeLists.txt): the console cannot list mounted folders with std::filesystem's small
+// read buffer.
+std::vector<fs::directory_entry> ListDirectory(const fs::path& path, std::error_code& ec) {
+    std::vector<fs::directory_entry> entries;
+    // NUP_LIST_DIRECTORY_BEGIN
+    for (const auto& entry : fs::directory_iterator(path, ec)) {
+        entries.push_back(entry);
+    }
+    // NUP_LIST_DIRECTORY_END
+    return entries;
+}
+
+// Every file and folder below root (not root itself).
+std::vector<fs::directory_entry> ListTree(const fs::path& root, std::error_code& ec) {
+    std::vector<fs::directory_entry> all;
+    std::vector<fs::path> pending{root};
+    while (!pending.empty()) {
+        const fs::path dir = std::move(pending.back());
+        pending.pop_back();
+        for (auto& entry : ListDirectory(dir, ec)) {
+            const bool folder = !entry.is_symlink(ec) && entry.is_directory(ec);
+            if (folder) {
+                pending.push_back(entry.path());
+            }
+            all.push_back(std::move(entry));
+        }
+        if (ec) {
+            break;
+        }
+    }
+    return all;
+}
